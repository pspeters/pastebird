<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates src/Pastebird/Assets/pastebird.ico (see README for the command). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Run through "dotnet IconGen.dll": no unsigned .exe that endpoint security may block. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>
