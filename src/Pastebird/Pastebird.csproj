<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection gives access to the built-in text recognition (Windows.Media.Ocr). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pastebird</RootNamespace>
    <AssemblyName>Pastebird</AssemblyName>
    <ApplicationIcon>Assets\pastebird.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>Pastebird</Product>
    <Version>1.7.0</Version>
    <Description>Pastebird - simple clipboard history for Windows</Description>

    <!-- Small footprint: no satellite assemblies, workstation non-concurrent GC. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- Window.ThemeMode (Fluent) is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Microsoft Store (MSIX) build: -p:PastebirdMsix=true. Uses the package's StartupTask for autostart. -->
  <PropertyGroup Condition="'$(PastebirdMsix)' == 'true'">
    <DefineConstants>$(DefineConstants);MSIX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\pastebird.ico" />
    <!-- Shown in "What's new" after an update (Core/Changelog.cs). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

</Project>
