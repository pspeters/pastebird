<Window x:Class="Pastebird.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Pastebird.Core"
        Title="{Binding [settings.title], Source={x:Static core:Loc.Instance}}"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,18">

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [settings.autostart], Source={x:Static core:Loc.Instance}}" />
                        <TextBlock x:Name="AutoStartHint" Style="{StaticResource Description}" />
                    </StackPanel>
                    <CheckBox x:Name="AutoStartBox" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [settings.autopaste], Source={x:Static core:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding [settings.autopaste.desc], Source={x:Static core:Loc.Instance}}" />
                    </StackPanel>
                    <CheckBox x:Name="AutoPasteBox" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [settings.hotkey], Source={x:Static core:Loc.Instance}}" />
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Description}" />
                    </StackPanel>
                    <TextBox x:Name="HotkeyBox" Grid.Column="1" Width="170" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             TextAlignment="Center" VerticalAlignment="Center" Cursor="Hand" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [settings.history], Source={x:Static core:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding [settings.history.desc], Source={x:Static core:Loc.Instance}}" />
                    </StackPanel>
                    <ComboBox x:Name="HistorySizeBox" Grid.Column="1" Width="170" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [settings.keep], Source={x:Static core:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding [settings.keep.desc], Source={x:Static core:Loc.Instance}}" />
                    </StackPanel>
                    <ComboBox x:Name="KeepDaysBox" Grid.Column="1" Width="170" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [settings.language], Source={x:Static core:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding [settings.language.desc], Source={x:Static core:Loc.Instance}}" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="170" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:Name="UpdatesCard" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding [settings.updates], Source={x:Static core:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource Description}" Text="{Binding [settings.updates.desc], Source={x:Static core:Loc.Instance}}" />
                        </StackPanel>
                        <CheckBox x:Name="UpdatesBox" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Description}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button x:Name="UpdateButton" Grid.Column="1" Width="170" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding [settings.clear], Source={x:Static core:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding [settings.clear.desc], Source={x:Static core:Loc.Instance}}" />
                    </StackPanel>
                    <Button x:Name="ClearButton" Grid.Column="1" Width="170" VerticalAlignment="Center"
                            Content="{Binding [settings.clear.button], Source={x:Static core:Loc.Instance}}" />
                </Grid>
            </Border>

            <!-- About -->
            <TextBlock Style="{StaticResource Section}" Text="{Binding [about.title], Source={x:Static core:Loc.Instance}}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AppIcon" Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Pastebird" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Description}" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding [about.createdBy], Source={x:Static core:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource Description}" Text="{Binding [about.local], Source={x:Static core:Loc.Instance}}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="DonateButton" Margin="0,0,8,4" Style="{DynamicResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2615;" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding [about.donate], Source={x:Static core:Loc.Instance}}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WhatsNewButton" Margin="0,0,8,4"
                                    Content="{Binding [about.whatsnew], Source={x:Static core:Loc.Instance}}" />
                            <Button x:Name="GitHubButton" Margin="0,0,8,4"
                                    Content="{Binding [about.github], Source={x:Static core:Loc.Instance}}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
