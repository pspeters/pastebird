<Window x:Class="Pastebird.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Pastebird.Core"
        xmlns:ui="clr-namespace:Pastebird.UI"
        Title="Pastebird"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Foreground="{DynamicResource TextPrimary}">

    <!-- Client area covers the whole window; DWM draws backdrop, rounded corners and shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Placeholder values; PopupWindow.ApplyTheme sets the real light/dark brushes. -->
        <SolidColorBrush x:Key="Surface" Color="Transparent" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E4000000" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9E000000" />
        <SolidColorBrush x:Key="TextTertiary" Color="#72000000" />
        <SolidColorBrush x:Key="Divider" Color="#14000000" />
        <SolidColorBrush x:Key="Hover" Color="#0A000000" />
        <SolidColorBrush x:Key="Selected" Color="#0F000000" />
        <SolidColorBrush x:Key="Accent" Color="#005FB8" />
        <SolidColorBrush x:Key="ScrollThumb" Color="#72000000" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <ui:ThumbnailConverter x:Key="ThumbnailConverter" />

        <!-- Slim Windows 11 style scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="2,2,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource ScrollThumb}" CornerRadius="1.5"
                                                    Width="3" HorizontalAlignment="Center" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClipItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent" />
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Accent}" Visibility="Collapsed" />
                            <ContentPresenter Margin="14,7,12,7" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Selected}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Surface}">
        <DockPanel>
            <!-- Search -->
            <Grid DockPanel.Dock="Top" Height="50" Margin="18,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,1,14,0" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" FontSize="15"
                           Text="{Binding [popup.search], Source={x:Static core:Loc.Instance}}"
                           Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                           Margin="2,0,0,0" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="15" VerticalAlignment="Center"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                         SelectionBrush="{DynamicResource Accent}" AcceptsReturn="False" AcceptsTab="False">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Grid>

            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}" />

            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="18,16,18,18"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Visibility="Collapsed" />

            <!-- Full content of the selected item and when it was copied, toggled with Tab. -->
            <Border x:Name="PreviewPane" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Divider}" Visibility="Collapsed">
                <StackPanel Margin="6">
                    <!-- Fixed heights, so the pane is equally tall for every item (see UpdatePreview). -->
                    <TextBlock x:Name="CopiedText" Height="16" Margin="12,4,8,2" FontSize="12"
                               Foreground="{DynamicResource TextTertiary}" />
                    <ScrollViewer x:Name="PreviewScroll" Height="150" Padding="12,4,8,4" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </ScrollViewer>
                    <Image x:Name="PreviewImage" Height="142" Margin="12,4,8,4" Stretch="Uniform" StretchDirection="DownOnly"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <ListBox x:Name="ResultList" Margin="6,5,6,6" MaxHeight="370"
                     Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                     ItemContainerStyle="{StaticResource ClipItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph, Mode=OneTime}" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,1,14,0" />
                            <DockPanel Grid.Column="1">
                                <!-- Thumbnail for images; the thumbnail is stored at twice this size. -->
                                <Image Source="{Binding Thumbnail, Mode=OneTime, Converter={StaticResource ThumbnailConverter}}"
                                       MaxHeight="32" MaxWidth="128" Margin="0,0,10,0" Stretch="Uniform"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Thumbnail, Mode=OneTime}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding Preview, Mode=OneTime}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- Pin toggle: always shown for pinned items, on hover for the others. Clicking it pins/unpins. -->
                            <TextBlock x:Name="PinToggle" Grid.Column="2" Tag="PinToggle" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" Padding="10,2,2,2" Margin="0,-2,-4,-2" Background="Transparent"
                                       VerticalAlignment="Center" Cursor="Hand"
                                       ToolTip="{Binding [popup.pin.tooltip], Source={x:Static core:Loc.Instance}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE718;" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPinned, Mode=OneTime}" Value="True">
                                                <Setter Property="Text" Value="&#xE840;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
